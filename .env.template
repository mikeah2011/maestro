# ─────────────────────────────────────────────────────────────────
# maestro 環境變數範本
# 使用方式：cp .env.template .env，填入實際的值後即可使用
# 注意：.env 已加入 .gitignore，請勿將真實憑證提交到 Git
# ─────────────────────────────────────────────────────────────────

# ── GitHub ──────────────────────────────────────────────────────
# Personal Access Token（需要 repo + pull_requests 讀寫權限）
GITHUB_TOKEN=
# 目標倉庫的 GitHub 組織或帳號名稱
GITHUB_OWNER=
# 目標倉庫名稱
GITHUB_REPO=

# ── GitLab（如使用 GitLab 平台）────────────────────────────────
# GITLAB_TOKEN=
# GITLAB_OWNER=
# GITLAB_REPO=

# ── Gitea（如使用 Gitea 平台）──────────────────────────────────
# GITEA_TOKEN=
# GITEA_OWNER=
# GITEA_REPO=

# ── Gitee（如使用 Gitee 平台）──────────────────────────────────
# GITEE_TOKEN=
# GITEE_OWNER=
# GITEE_REPO=

# ── AI Provider ──────────────────────────────────────────────────
# Anthropic API Key（可選：未設定時自動改用本機 Claude Code CLI）
# ANTHROPIC_API_KEY=

# OpenAI API Key（可選）
# OPENAI_API_KEY=

# Google AI API Key（可選）
# GOOGLE_API_KEY=

# 本機 Ollama 服務位址（可選，預設：http://localhost:11434）
# OLLAMA_BASE_URL=http://localhost:11434

# ── Maestro 行為覆寫 ─────────────────────────────────────────────
# 最大收斂輪數（預設：3，最大值：5）
# MAESTRO_MAX_ROUNDS=3

# 單次 loop 成本上限（美元）
# MAESTRO_COST_BUDGET_USD=5

# 日誌等級（debug | info | warn | error）
# MAESTRO_LOG_LEVEL=info
